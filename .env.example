# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (optional until online payments launch; without these the site
# tells owners to pay the shop directly and /api/payments returns 503)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: email vendors when a matching job is posted
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=Bosun <alerts@bosun.app>

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: force demo mode (canned services/RFPs, no login)
# VITE_DEMO_MODE=true

# Optional: inbound parts email (shops forward supplier/carrier emails to
# parts+<token>@VITE_INBOUND_EMAIL_DOMAIN). Point your inbound-mail provider at
# POST /api/inbound/parts-email?secret=INBOUND_EMAIL_SECRET
# VITE_INBOUND_EMAIL_DOMAIN=parts.bosun.app
# INBOUND_EMAIL_SECRET=long_random_string

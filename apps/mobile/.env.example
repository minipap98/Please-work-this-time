# Copy to apps/mobile/.env. Only EXPO_PUBLIC_* values exist in the app; never put a secret here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# The web app's origin; the mobile app calls its /api/* routes.
EXPO_PUBLIC_API_URL=https://getbosun.app
# Where receipts are forwarded (receipts@<domain>); defaults to inbox.getbosun.app.
EXPO_PUBLIC_INBOUND_EMAIL_DOMAIN=inbox.getbosun.app

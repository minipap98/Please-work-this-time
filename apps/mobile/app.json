{
  "expo": {
    "name": "Bosun",
    "slug": "bosun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bosun",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#052443"
    },
    "ios": {
      "bundleIdentifier": "app.getbosun.ios",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:getbosun.app",
        "webcredentials:getbosun.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of the work your boat needs, and snap invoices for the Boat Log.",
        "NSPhotoLibraryUsageDescription": "Attach photos of your boat to a job, and import invoices from your photos.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Show shops near you, sorted by distance."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.getbosun.android",
      "adaptiveIcon": {
        "backgroundColor": "#052443",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "getbosun.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#052443"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos of your boat to a job.",
          "cameraPermission": "Take photos of the work your boat needs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#052443",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show shops near you, sorted by distance."
        }
      ],
      "expo-document-picker",
      "expo-dev-client",
      "./plugins/withSceneDelegate"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "baed0c2f-f67d-4b57-85aa-c6e62365b868"
      }
    }
  }
}

# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe (optional until online payments launch; without these the site
# tells owners to pay the shop directly and /api/payments returns 503)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: email vendors when a matching job is posted
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=Bosun <alerts@bosun.app>

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional: a Map ID from Google Cloud (Map Management) enables styled HTML markers on the shop map.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: force demo mode (canned services/RFPs, no login)
# VITE_DEMO_MODE=true

# Optional: inbound parts email (shops forward supplier/carrier emails to
# parts+<token>@VITE_INBOUND_EMAIL_DOMAIN). Point your inbound-mail provider at
# POST /api/inbound/parts-email?secret=INBOUND_EMAIL_SECRET
# VITE_INBOUND_EMAIL_DOMAIN=parts.bosun.app
# INBOUND_EMAIL_SECRET=long_random_string
# Owners forward receipts to receipts@VITE_INBOUND_EMAIL_DOMAIN → POST /api/inbound/receipts?secret=INBOUND_EMAIL_SECRET

# Push notifications (mobile app). The Supabase Database Webhook on `notifications` posts to
# POST /api/v1/push/dispatch with header x-bosun-webhook-secret: PUSH_WEBHOOK_SECRET
# (see supabase/migrations/20261025_push_webhook.sql). Needs SUPABASE_SERVICE_ROLE_KEY.
# PUSH_WEBHOOK_SECRET=long_random_string
# Optional: an Expo access token if your Expo account enforces push security.
# EXPO_ACCESS_TOKEN=

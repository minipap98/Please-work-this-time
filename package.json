{
  "name": "bosun-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @bosun/web dev",
    "dev:web": "pnpm --filter @bosun/web dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @bosun/web build",
    "start": "pnpm --filter @bosun/web start",
    "test": "turbo run test",
    "test:web": "pnpm --filter @bosun/web test",
    "test:shared": "pnpm --filter @bosun/shared test",
    "test:smoke": "pnpm --filter @bosun/web test:smoke",
    "typecheck": "turbo run typecheck",
    "format.fix": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
